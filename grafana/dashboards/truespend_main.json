{
  "__inputs": [
    {
      "name": "DS_SUPABASE_PG",
      "label": "Supabase PostgreSQL",
      "description": "",
      "type": "datasource",
      "pluginId": "postgres",
      "pluginName": "PostgreSQL"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "postgres",
      "name": "PostgreSQL",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "bargauge",
      "name": "Bar gauge",
      "version": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "TrueSpend command centre — live spend position, contract health, supplier signals, and agent activity.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "id": 1,
      "type": "stat",
      "title": "Transactions This Month",
      "description": "Total procurement decisions logged in the current calendar month.",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "postgres", "uid": "supabase-pg" },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "supabase-pg" },
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT COUNT(*) AS value FROM decisions WHERE created_at >= date_trunc('month', now())",
          "refId": "A"
        }
      ]
    },

    {
      "id": 2,
      "type": "stat",
      "title": "Auto-Executed This Month",
      "description": "Decisions resolved by the agent without human intervention in the current month.",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "postgres", "uid": "supabase-pg" },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "supabase-pg" },
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT COUNT(*) AS value FROM decisions WHERE disposition = 'auto_execute' AND created_at >= date_trunc('month', now())",
          "refId": "A"
        }
      ]
    },

    {
      "id": 3,
      "type": "stat",
      "title": "Auto-Execute Rate",
      "description": "Percentage of this month's decisions closed by the agent without human touch. Target: >80%.",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "postgres", "uid": "supabase-pg" },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 1,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "green",  "value": 80 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "supabase-pg" },
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT ROUND(COUNT(*) FILTER (WHERE disposition = 'auto_execute')::numeric / NULLIF(COUNT(*),0) * 100, 1) AS value FROM decisions WHERE created_at >= date_trunc('month', now())",
          "refId": "A"
        }
      ]
    },

    {
      "id": 4,
      "type": "stat",
      "title": "Pending Human Action",
      "description": "Tickets currently awaiting confirmation or escalated for review. Should be close to zero.",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "postgres", "uid": "supabase-pg" },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "options": { "0": { "color": "green", "index": 0, "text": "0" } },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red",    "value": 5 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "supabase-pg" },
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT COUNT(*) AS value FROM tickets WHERE status IN ('pending_confirm', 'escalated')",
          "refId": "A"
        }
      ]
    },

    {
      "id": 9,
      "type": "stat",
      "title": "Contracts in Renewal Window (≤90 days)",
      "description": "Active contracts expiring within the next 90 days. Each one needs a decision or renewal action.",
      "gridPos": { "x": 0, "y": 4, "w": 6, "h": 4 },
      "datasource": { "type": "postgres", "uid": "supabase-pg" },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 3 },
              { "color": "red",    "value": 8 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "supabase-pg" },
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT COUNT(*) AS value FROM contracts WHERE expiry_date <= now() + interval '90 days' AND expiry_date > now()",
          "refId": "A"
        }
      ]
    },

    {
      "id": 5,
      "type": "table",
      "title": "Contracts Expiring This Week",
      "description": "Contracts with fewer than 7 days remaining. Requires immediate action.",
      "gridPos": { "x": 6, "y": 4, "w": 18, "h": 8 },
      "datasource": { "type": "postgres", "uid": "supabase-pg" },
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": ["sum"],
          "show": false
        },
        "showHeader": true,
        "sortBy": [{ "desc": false, "displayName": "days_remaining" }]
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red",   "value": 80 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "days_remaining" },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": { "mode": "gradient", "type": "color-background" }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "red",    "value": null },
                    { "color": "yellow", "value": 3 },
                    { "color": "green",  "value": 6 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "value" },
            "properties": [
              { "id": "unit", "value": "currencyEUR" },
              { "id": "decimals", "value": 0 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "renewal_state" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "options": { "not_started": { "color": "red",    "index": 0, "text": "Not Started" }, "in_progress": { "color": "yellow", "index": 1, "text": "In Progress" }, "complete": { "color": "green",  "index": 2, "text": "Complete"    } }, "type": "value" }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": { "mode": "gradient", "type": "color-background" }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "supabase-pg" },
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT name, supplier_name, value, currency, days_remaining, renewal_state, owner_name FROM contracts_expiring WHERE days_remaining <= 7 ORDER BY days_remaining ASC",
          "refId": "A"
        }
      ]
    },

    {
      "id": 10,
      "type": "table",
      "title": "Supplier Health",
      "description": "Suppliers not currently green — ordered by health status and open disputes.",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "postgres", "uid": "supabase-pg" },
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": ["sum"],
          "show": false
        },
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red",   "value": 80 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "health" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "red":    { "color": "red",    "index": 0, "text": "Critical" },
                      "amber":  { "color": "orange", "index": 1, "text": "Amber"    },
                      "yellow": { "color": "yellow", "index": 2, "text": "Watch"    },
                      "green":  { "color": "green",  "index": 3, "text": "Healthy"  }
                    },
                    "type": "value"
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": { "mode": "gradient", "type": "color-background" }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "sla_status" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "breached":    { "color": "red",    "index": 0, "text": "Breached"    },
                      "at_risk":     { "color": "yellow", "index": 1, "text": "At Risk"     },
                      "compliant":   { "color": "green",  "index": 2, "text": "Compliant"   }
                    },
                    "type": "value"
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": { "mode": "gradient", "type": "color-background" }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "open_disputes" },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green",  "value": null },
                    { "color": "yellow", "value": 1 },
                    { "color": "red",    "value": 3 }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": { "mode": "gradient", "type": "color-background" }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "supabase-pg" },
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT name, category, health, sla_status, open_disputes, last_contact FROM suppliers WHERE health != 'green' ORDER BY health DESC, open_disputes DESC",
          "refId": "A"
        }
      ]
    },

    {
      "id": 8,
      "type": "bargauge",
      "title": "Hyperscaler MTD Position",
      "description": "Month-to-date spend vs committed amounts across AWS, GCP, and Azure. Red indicates committed shortfall risk.",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "postgres", "uid": "supabase-pg" },
      "options": {
        "displayMode": "gradient",
        "minVizHeight": 10,
        "minVizWidth": 0,
        "namePlacement": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": true
        },
        "showUnfilled": true,
        "valueMode": "color"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "mappings": [],
          "max": null,
          "min": 0,
          "thresholds": {
            "mode": "percentage",
            "steps": [
              { "color": "blue",   "value": null },
              { "color": "green",  "value": 60 },
              { "color": "yellow", "value": 85 },
              { "color": "red",    "value": 100 }
            ]
          },
          "unit": "currencyEUR"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "supabase-pg" },
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT provider, SUM(mtd_spend_eur) AS spent, SUM(committed_eur) AS committed FROM hyperscaler_positions WHERE snapshot_date = (SELECT MAX(snapshot_date) FROM hyperscaler_positions) GROUP BY provider ORDER BY provider",
          "refId": "A"
        }
      ]
    },

    {
      "id": 7,
      "type": "timeseries",
      "title": "Agent Decisions Over Time",
      "description": "30-day rolling view of agent decision volume by disposition type.",
      "gridPos": { "x": 0, "y": 16, "w": 14, "h": 9 },
      "datasource": { "type": "postgres", "uid": "supabase-pg" },
      "options": {
        "legend": {
          "calcs": ["sum"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red",   "value": 80 }
            ]
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "auto_execute" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } },
              { "id": "displayName", "value": "Auto-Execute" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "one_touch" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } },
              { "id": "displayName", "value": "One-Touch" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "escalate" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } },
              { "id": "displayName", "value": "Escalated" }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "supabase-pg" },
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT date_trunc('day', created_at) AS time, COUNT(*) FILTER (WHERE disposition = 'auto_execute') AS auto_execute, COUNT(*) FILTER (WHERE disposition = 'one_touch') AS one_touch, COUNT(*) FILTER (WHERE disposition = 'escalate') AS escalate FROM decisions WHERE created_at >= now() - interval '30 days' GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ]
    },

    {
      "id": 6,
      "type": "table",
      "title": "Weekly Digest — Needs Attention",
      "description": "Top 20 items surfaced by the weekly agent digest. These require a human decision or acknowledgement.",
      "gridPos": { "x": 14, "y": 16, "w": 10, "h": 9 },
      "datasource": { "type": "postgres", "uid": "supabase-pg" },
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": ["sum"],
          "show": false
        },
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red",   "value": 80 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "disposition" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "auto_execute": { "color": "green",  "index": 0, "text": "Auto-Execute" },
                      "one_touch":    { "color": "blue",   "index": 1, "text": "One-Touch"    },
                      "escalate":     { "color": "orange", "index": 2, "text": "Escalated"    },
                      "pending":      { "color": "yellow", "index": 3, "text": "Pending"      }
                    },
                    "type": "value"
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": { "mode": "gradient", "type": "color-background" }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "confidence" },
            "properties": [
              { "id": "unit", "value": "percentunit" },
              { "id": "decimals", "value": 0 },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "red",    "value": null },
                    { "color": "yellow", "value": 0.6 },
                    { "color": "green",  "value": 0.85 }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": { "mode": "gradient", "type": "color-background" }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "amount" },
            "properties": [
              { "id": "unit", "value": "currencyEUR" },
              { "id": "decimals", "value": 0 }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "supabase-pg" },
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT reference, title, status, amount, currency, disposition, confidence, owner_name FROM weekly_digest LIMIT 20",
          "refId": "A"
        }
      ]
    }

  ],
  "refresh": "5m",
  "schemaVersion": 38,
  "tags": ["truespend", "procurement", "command-center"],
  "templating": { "list": [] },
  "time": { "from": "now-30d", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "TrueSpend — Command Center",
  "uid": "truespend-main-v1",
  "version": 1,
  "weekStart": "monday"
}
