{
  "name": "TrueSpend — Delivery Confirmation",
  "description": "Triggered when goods are received: either via Operations Board 'Mark Delivered' button (PATCH /purchase_orders/:id → status=delivered) or via webhook from supplier. Calls confirm_delivery RPC, flags late delivery, updates ticket status, triggers invoice match if invoice already received.",
  "nodes": [

    {
      "id": "webhook_trigger",
      "name": "Delivery Webhook",
      "type": "n8n-nodes-base.webhook",
      "parameters": {
        "httpMethod": "POST",
        "path": "delivery-confirmation",
        "responseMode": "responseNode",
        "authentication": "basicAuth"
      },
      "position": [0, 400]
    },

    {
      "id": "validate_input",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "parameters": {
        "jsCode": "// Accept: { po_id, confirmed_by, delivery_date?, notes?, received_items? }\nconst body = $input.item.json.body || $input.item.json;\n\nconst po_id = body.po_id;\nconst confirmed_by = body.confirmed_by || 'system';\nconst delivery_date = body.delivery_date || new Date().toISOString().split('T')[0];\nconst notes = body.notes || null;\nconst received_items = body.received_items || null;\n\nif (!po_id) {\n  throw new Error('Missing required field: po_id');\n}\n\nreturn [{ json: { po_id, confirmed_by, delivery_date, notes, received_items } }];"
      },
      "position": [200, 400]
    },

    {
      "id": "fetch_po",
      "name": "Fetch PO + Ticket",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "GET",
        "url": "={{ $env.POSTGREST_URL }}/purchase_orders?id=eq.{{ $json.po_id }}&select=id,po_number,supplier_id,branch_id,amount,amount_eur,currency,status,expected_delivery,ticket_id",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{ $env.POSTGREST_JWT }}" },
            { "name": "Accept",        "value": "application/json" }
          ]
        },
        "options": { "timeout": 15000 }
      },
      "position": [400, 400]
    },

    {
      "id": "check_po_exists",
      "name": "PO Found?",
      "type": "n8n-nodes-base.if",
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.length }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "position": [600, 400]
    },

    {
      "id": "respond_not_found",
      "name": "Respond — PO Not Found",
      "type": "n8n-nodes-base.respondToWebhook",
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ error: 'PO not found', po_id: $('Validate Input').item.json.po_id }) }}",
        "options": { "responseCode": 404 }
      },
      "position": [800, 600]
    },

    {
      "id": "extract_po",
      "name": "Extract PO Data",
      "type": "n8n-nodes-base.code",
      "parameters": {
        "jsCode": "const po = $input.item.json[0];\nconst input = $('Validate Input').item.json;\n\nconst expectedDate = new Date(po.expected_delivery);\nconst deliveredDate = new Date(input.delivery_date);\nconst daysLate = Math.max(0, Math.floor((deliveredDate - expectedDate) / (1000 * 60 * 60 * 24)));\nconst isLate = deliveredDate > expectedDate;\n\nreturn [{ json: {\n  ...input,\n  po_number:    po.po_number,\n  supplier_id:  po.supplier_id,\n  branch_id:    po.branch_id,\n  amount_eur:   po.amount_eur,\n  currency:     po.currency,\n  current_status: po.status,\n  ticket_id:    po.ticket_id,\n  expected_delivery: po.expected_delivery,\n  days_late:    daysLate,\n  is_late:      isLate\n} }];"
      },
      "position": [800, 400]
    },

    {
      "id": "call_confirm_delivery",
      "name": "RPC — confirm_delivery",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.POSTGREST_URL }}/rpc/confirm_delivery",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{ $env.POSTGREST_JWT }}" },
            { "name": "Content-Type",  "value": "application/json" },
            { "name": "Prefer",        "value": "return=representation" }
          ]
        },
        "body": {
          "p_po_id":         "={{ $json.po_id }}",
          "p_confirmed_by":  "={{ $json.confirmed_by }}",
          "p_delivery_date": "={{ $json.delivery_date }}",
          "p_notes":         "={{ $json.notes }}"
        },
        "options": { "timeout": 30000 }
      },
      "position": [1000, 400],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },

    {
      "id": "check_for_invoice",
      "name": "Invoice Already Received?",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "GET",
        "url": "={{ $env.POSTGREST_URL }}/invoices?po_id=eq.{{ $('Extract PO Data').item.json.po_id }}&status=in.(received,pending_review)&limit=1",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{ $env.POSTGREST_JWT }}" },
            { "name": "Accept",        "value": "application/json" }
          ]
        },
        "options": { "timeout": 15000 }
      },
      "position": [1200, 400]
    },

    {
      "id": "invoice_waiting",
      "name": "Invoice Waiting?",
      "type": "n8n-nodes-base.if",
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.length }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "position": [1400, 400]
    },

    {
      "id": "trigger_invoice_match",
      "name": "Trigger — 3-Way Match",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.POSTGREST_URL }}/rpc/match_invoice",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{ $env.POSTGREST_JWT }}" },
            { "name": "Content-Type",  "value": "application/json" },
            { "name": "Prefer",        "value": "return=representation" }
          ]
        },
        "body": {
          "p_invoice_id": "={{ $json[0].id }}"
        },
        "options": { "timeout": 30000 }
      },
      "position": [1600, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },

    {
      "id": "late_delivery_check",
      "name": "Late Delivery?",
      "type": "n8n-nodes-base.if",
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $('Extract PO Data').item.json.is_late }}",
              "value2": true
            }
          ]
        }
      },
      "position": [1600, 500]
    },

    {
      "id": "create_late_ticket",
      "name": "Create Late Delivery Ticket",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.POSTGREST_URL }}/tickets",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{ $env.POSTGREST_JWT }}" },
            { "name": "Content-Type",  "value": "application/json" },
            { "name": "Prefer",        "value": "return=representation" }
          ]
        },
        "body": {
          "id":           "={{ $uuid() }}",
          "reference":    "={{ 'TS-' + new Date().getFullYear() + '-' + Math.floor(1000 + Math.random() * 9000) }}",
          "source":       "automatic",
          "status":       "pending_confirm",
          "title":        "={{ 'Late delivery — ' + $('Extract PO Data').item.json.po_number + ' — ' + $('Extract PO Data').item.json.days_late + ' days late' }}",
          "description":  "={{ 'PO ' + $('Extract PO Data').item.json.po_number + ' delivered ' + $('Extract PO Data').item.json.days_late + ' day(s) late (expected: ' + $('Extract PO Data').item.json.expected_delivery + ', received: ' + $('Extract PO Data').item.json.delivery_date + '). Supplier health record updated. Review SLA terms and consider penalty clause if delay exceeds SLA threshold.' }}",
          "category":     "={{ $('Extract PO Data').item.json.currency === 'EUR' ? 'hardware' : 'hardware' }}",
          "supplier_id":  "={{ $('Extract PO Data').item.json.supplier_id }}",
          "branch_id":    "={{ $('Extract PO Data').item.json.branch_id }}",
          "review_type":  "budget_check",
          "review_notes": "={{ 'Late delivery: ' + $('Extract PO Data').item.json.days_late + ' days. Automated SLA flag. Check contract terms for penalty clause applicability.' }}",
          "created_at":   "={{ new Date().toISOString() }}",
          "updated_at":   "={{ new Date().toISOString() }}"
        },
        "options": { "timeout": 15000 }
      },
      "position": [1800, 400],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },

    {
      "id": "write_trace",
      "name": "Write Trace Log",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.POSTGREST_URL }}/trace_log",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{ $env.POSTGREST_JWT }}" },
            { "name": "Content-Type",  "value": "application/json" }
          ]
        },
        "body": {
          "workflow":   "delivery_confirmation",
          "signal":     "contract",
          "disposition":"={{ $('Extract PO Data').item.json.is_late ? 'one_touch' : 'auto_execute' }}",
          "confidence": "={{ $('Extract PO Data').item.json.is_late ? 0.85 : 0.99 }}",
          "reasoning":  "={{ 'PO ' + $('Extract PO Data').item.json.po_number + ' confirmed delivered on ' + $('Extract PO Data').item.json.delivery_date + '. ' + ($('Extract PO Data').item.json.is_late ? 'LATE: ' + $('Extract PO Data').item.json.days_late + ' days past expected date.' : 'On time.') + ' Confirmed by: ' + $('Extract PO Data').item.json.confirmed_by + '.' }}",
          "created_at": "={{ new Date().toISOString() }}"
        },
        "options": { "timeout": 15000 }
      },
      "position": [2000, 400]
    },

    {
      "id": "write_workflow_run",
      "name": "Write Workflow Run",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.POSTGREST_URL }}/workflow_runs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{ $env.POSTGREST_JWT }}" },
            { "name": "Content-Type",  "value": "application/json" }
          ]
        },
        "body": {
          "id":            "={{ $uuid() }}",
          "workflow_name": "delivery_confirmation",
          "status":        "success",
          "started_at":    "={{ $('Webhook Delivery').item.json.headers?.['x-request-start'] || new Date().toISOString() }}",
          "ended_at":      "={{ new Date().toISOString() }}"
        },
        "options": { "timeout": 10000 }
      },
      "position": [2200, 400]
    },

    {
      "id": "respond_success",
      "name": "Respond — Confirmed",
      "type": "n8n-nodes-base.respondToWebhook",
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, po_id: $('Extract PO Data').item.json.po_id, po_number: $('Extract PO Data').item.json.po_number, delivery_date: $('Extract PO Data').item.json.delivery_date, is_late: $('Extract PO Data').item.json.is_late, days_late: $('Extract PO Data').item.json.days_late, invoice_match_triggered: $('Invoice Already Received?').item.json.length > 0 }) }}",
        "options": { "responseCode": 200 }
      },
      "position": [2400, 400]
    },

    {
      "id": "no_late_ticket",
      "name": "On Time — No Alert",
      "type": "n8n-nodes-base.noOp",
      "parameters": {},
      "position": [1800, 600]
    }
  ],

  "connections": {
    "Delivery Webhook": {
      "main": [[{ "node": "Validate Input", "type": "main", "index": 0 }]]
    },
    "Validate Input": {
      "main": [[{ "node": "Fetch PO + Ticket", "type": "main", "index": 0 }]]
    },
    "Fetch PO + Ticket": {
      "main": [[{ "node": "PO Found?", "type": "main", "index": 0 }]]
    },
    "PO Found?": {
      "main": [
        [{ "node": "Respond — PO Not Found", "type": "main", "index": 0 }],
        [{ "node": "Extract PO Data",        "type": "main", "index": 0 }]
      ]
    },
    "Extract PO Data": {
      "main": [[{ "node": "RPC — confirm_delivery", "type": "main", "index": 0 }]]
    },
    "RPC — confirm_delivery": {
      "main": [[{ "node": "Invoice Already Received?", "type": "main", "index": 0 }]]
    },
    "Invoice Already Received?": {
      "main": [[{ "node": "Invoice Waiting?", "type": "main", "index": 0 }]]
    },
    "Invoice Waiting?": {
      "main": [
        [{ "node": "Trigger — 3-Way Match", "type": "main", "index": 0 }],
        [{ "node": "Late Delivery?",        "type": "main", "index": 0 }]
      ]
    },
    "Trigger — 3-Way Match": {
      "main": [[{ "node": "Late Delivery?", "type": "main", "index": 0 }]]
    },
    "Late Delivery?": {
      "main": [
        [{ "node": "Create Late Delivery Ticket", "type": "main", "index": 0 }],
        [{ "node": "On Time — No Alert",          "type": "main", "index": 0 }]
      ]
    },
    "Create Late Delivery Ticket": {
      "main": [[{ "node": "Write Trace Log", "type": "main", "index": 0 }]]
    },
    "On Time — No Alert": {
      "main": [[{ "node": "Write Trace Log", "type": "main", "index": 0 }]]
    },
    "Write Trace Log": {
      "main": [[{ "node": "Write Workflow Run", "type": "main", "index": 0 }]]
    },
    "Write Workflow Run": {
      "main": [[{ "node": "Respond — Confirmed", "type": "main", "index": 0 }]]
    }
  }
}
