{
  "name": "TrueSpend â€” Automatic Reorder Trigger",
  "description": "Runs every 6 hours. Detects when consumable items or recurring purchases need reordering based on consumption patterns, contract terms, and stock signals. For hardware bulk reorders within existing framework contracts (Dell, Lenovo, Apple) â€” checks: is this within existing contract terms? budget headroom? supplier health green? If all yes â†’ places order automatically via supplier email + logs PO to PostgREST. If one signal uncertain â†’ one-touch Slack confirm to manager. Novel or above threshold â†’ escalate Jira.",
  "nodes": [
    {
      "id": "trigger",
      "name": "Every 6 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 */6 * * *"
            }
          ]
        }
      },
      "position": [
        0,
        300
      ]
    },
    {
      "id": "fetch_reorder_candidates",
      "name": "Fetch Reorder Candidates",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "GET",
        "url": "https://postgrest-production-7960.up.railway.app/contracts?category=in.(hardware,saas_license)&auto_renew=eq.true&renewal_state=neq.manual_required",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.POSTGREST_JWT }}"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        }
      },
      "position": [
        200,
        300
      ]
    },
    {
      "id": "fetch_budget_signals",
      "name": "Fetch Budget Spend Signals",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "GET",
        "url": "=https://postgrest-production-7960.up.railway.app/budget_positions?category=in.(hardware,saas_license)&period=eq.{{ new Date().getFullYear() + '-Q' + Math.ceil((new Date().getMonth()+1)/3) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.POSTGREST_JWT }}"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        }
      },
      "position": [
        200,
        480
      ]
    },
    {
      "id": "check_any_candidates",
      "name": "Any Reorder Candidates?",
      "type": "n8n-nodes-base.if",
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $node['Fetch Reorder Candidates'].json.length }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "position": [
        400,
        300
      ]
    },
    {
      "id": "loop_contracts",
      "name": "Loop Each Contract",
      "type": "n8n-nodes-base.splitInBatches",
      "parameters": {
        "batchSize": 1
      },
      "position": [
        600,
        300
      ]
    },
    {
      "id": "fetch_supplier_health",
      "name": "Fetch Supplier Health",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "GET",
        "url": "=https://postgrest-production-7960.up.railway.app/suppliers?id=eq.{{ $json.supplier_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.POSTGREST_JWT }}"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        }
      },
      "position": [
        800,
        200
      ]
    },
    {
      "id": "fetch_contract_budget",
      "name": "Fetch Contract Budget Position",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "GET",
        "url": "=https://postgrest-production-7960.up.railway.app/budget_positions?branch_id=eq.{{ $node['Loop Each Contract'].json.branch_id }}&period=eq.{{ new Date().getFullYear() + '-Q' + Math.ceil((new Date().getMonth()+1)/3) }}&category=eq.{{ $node['Loop Each Contract'].json.category }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.POSTGREST_JWT }}"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        }
      },
      "position": [
        800,
        360
      ]
    },
    {
      "id": "fetch_contract_terms",
      "name": "Fetch Contract Terms",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "GET",
        "url": "=https://postgrest-production-7960.up.railway.app/contracts?id=eq.{{ $node['Loop Each Contract'].json.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.POSTGREST_JWT }}"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        }
      },
      "position": [
