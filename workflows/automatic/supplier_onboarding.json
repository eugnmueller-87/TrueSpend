{
  "name": "TrueSpend â€” Supplier Onboarding & Compliance",
  "description": "Triggered when a new supplier is created. Runs 4 compliance agents in parallel: Lawyer (NDA), GDPR/DPA, InfoSec, and LkSG/Ethics. Generates required legal documents. Creates a ticket only if there are blockers or the supplier needs signature on docs. Everything else is logged to DB silently.",
  "nodes": [
    {
      "id": "trigger",
      "name": "New Supplier Webhook",
      "type": "n8n-nodes-base.webhook",
      "parameters": {
        "path": "supplier-onboarding",
        "httpMethod": "POST",
        "responseMode": "lastNode",
        "responseData": "allEntries"
      },
      "position": [
        0,
        0
      ]
    },
    {
      "id": "fetch_supplier",
      "name": "Fetch Supplier Details",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "GET",
        "url": "={{ $env.POSTGREST_URL || 'https://postgrest-production-7960.up.railway.app' }}/suppliers?id=eq.{{ $json.body.supplier_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.POSTGREST_JWT }}"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        }
      },
      "position": [
        240,
        0
      ]
    },
    {
      "id": "set_supplier",
      "name": "Extract Supplier",
      "type": "n8n-nodes-base.set",
      "parameters": {
        "values": {
          "string": [
            {
              "name": "supplier_id",
              "value": "={{ $json[0].id }}"
            },
            {
              "name": "supplier_name",
              "value": "={{ $json[0].name }}"
            },
            {
              "name": "legal_name",
              "value": "={{ $json[0].legal_name || $json[0].name }}"
            },
            {
              "name": "country",
              "value": "={{ $json[0].country }}"
            },
            {
              "name": "category",
              "value": "={{ $json[0].category }}"
            },
            {
              "name": "contact_email",
              "value": "={{ $json[0].contact_email }}"
            }
          ]
        }
      },
      "position": [
        480,
        0
      ]
    },
    {
      "id": "mark_running",
      "name": "Mark Compliance Running",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.POSTGREST_URL || 'https://postgrest-production-7960.up.railway.app' }}/suppliers?id=eq.{{ $json.supplier_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.POSTGREST_JWT }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "bodyParameters": {
          "parameters": [
            {
              "name": "body",
              "value": "={{ JSON.stringify({ compliance_status: 'running' }) }}"
            }
          ]
        }
      },
      "position": [
        720,
        0
      ],
      "options": {
        "timeout": 30000
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "claude_lawyer",
      "name": "Lawyer Agent â€” Legal & NDA Review",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "bodyParameters": {
          "parameters": [
            {
              "name": "body",
              "value": "={\n  \"model\": \"claude-sonnet-4-6\",\n  \"max_tokens\": 2048,\n  \"system\": \"You are TrueSpend's Legal Agent. You assess new supplier relationships for legal risk and determine which legal documents are required. You are expert in German commercial law, EU contract law, and standard B2B procurement agreements. You generate NDA content and flag legal risks. Always return structured JSON.\",\n  \"messages\": [{\n    \"role\": \"user\",\n    \"content\": \"Assess this new supplier for legal risk and NDA requirements.\\n\\nSUPPLIER:\\nName: {{ $node['Extract Supplier'].json.supplier_name }}\\nLegal name: {{ $node['Extract Supplier'].json.legal_name }}\\nCountry: {{ $node['Extract Supplier'].json.country }}\\nCategory: {{ $node['Extract Supplier'].json.category }}\\n\\nTASKS:\\n1. Assess legal risk of engaging this supplier\\n2. Determine if NDA is required (almost always yes for new suppliers)\\n3. Generate NDA content filling in these template variables:\\n   - EFFECTIVE_DATE: today {{ new Date().toISOString().split('T')[0] }}\\n   - SUPPLIER_LEGAL_NAME: {{ $node['Extract Supplier'].json.legal_name }}\\n   - SUPPLIER_COUNTRY: {{ $node['Extract Supplier'].json.country }}\\n   - SUPPLIER_ADDRESS: [to be completed by supplier]\\n   - PURPOSE: procurement and vendor relationship management\\n   - TERM_YEARS: 3\\n   - SURVIVAL_YEARS: 5\\n   - JURISDICTION_CITY: Munich\\n   - TRUESPEND_ADDRESS: Munich, Germany\\n4. Flag any legal red flags for this supplier type\\n\\nReturn JSON:\\n{\\n  \\\"nda_required\\\": true|false,\\n  \\\"nda_content\\\": \\\"full NDA text with variables filled in\\\",\\n  \\\"legal_risk_score\\\": 0-100,\\n  \\\"risk_level\\\": \\\"low|medium|high\\\",\\n  \\\"findings\\\": [\\\"list of findings\\\"],\\n  \\\"blockers\\\": [\\\"must-fix items\\\"],\\n  \\\"recommendations\\\": [\\\"nice-to-have items\\\"],\\n  \\\"passed\\\": true|false\\n}\"\n  }]\n}"
            }
          ]
        }
      },
      "position": [
        960,
        -300
      ],
      "options": {
        "timeout": 120000
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "claude_gdpr",
      "name": "GDPR Agent â€” Privacy & DPA Review",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "bodyParameters": {
          "parameters": [
            {
              "name": "body",
              "value": "={\n  \"model\": \"claude-sonnet-4-6\",\n  \"max_tokens\": 2048,\n  \"system\": \"You are TrueSpend's GDPR Agent. You assess whether suppliers require a Data Processing Agreement under Art. 28 GDPR and generate DPA content. You are expert in GDPR, BDSG, EU data protection law, Standard Contractual Clauses, and data residency requirements. Always return structured JSON.\",\n  \"messages\": [{\n    \"role\": \"user\",\n    \"content\": \"Assess this supplier for GDPR compliance and DPA requirements.\\n\\nSUPPLIER:\\nName: {{ $node['Extract Supplier'].json.supplier_name }}\\nCountry: {{ $node['Extract Supplier'].json.country }}\\nCategory: {{ $node['Extract Supplier'].json.category }}\\n\\nTASKS:\\n1. Determine if this supplier will process personal data on behalf of TrueSpend\\n2. If yes, determine if Standard Contractual Clauses are needed (non-EU supplier)\\n3. Generate DPA content with:\\n   - EFFECTIVE_DATE: {{ new Date().toISOString().split('T')[0] }}\\n   - SUPPLIER_LEGAL_NAME: {{ $node['Extract Supplier'].json.legal_name }}\\n   - SERVICE_DESCRIPTION: {{ $node['Extract Supplier'].json.category }} services\\n   - JURISDICTION_CITY: Munich\\n   - Fill in appropriate processing nature, purpose, data subjects, data categories based on supplier category\\n   - Generate TOM_CONTENT appropriate for this supplier type\\n4. Flag any GDPR red flags\\n\\nReturn JSON:\\n{\\n  \\\"dpa_required\\\": true|false,\\n  \\\"scc_required\\\": true|false,\\n  \\\"processes_personal_data\\\": true|false,\\n  \\\"data_residency\\\": \\\"EU|non-EU|mixed\\\",\\n  \\\"dpa_content\\\": \\\"full DPA text with variables filled in\\\",\\n  \\\"gdpr_risk_score\\\": 0-100,\\n  \\\"risk_level\\\": \\\"low|medium|high\\\",\\n  \\\"findings\\\": [],\\n  \\\"blockers\\\": [],\\n  \\\"recommendations\\\": [],\\n  \\\"passed\\\": true|false\\n}\"\n  }]\n}"
            }
          ]
        }
      },
      "position": [
        960,
        -100
      ],
      "options": {
        "timeout": 120000
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "claude_infosec",
      "name": "InfoSec Agent â€” Security Assessment",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "bodyParameters": {
          "parameters": [
            {
              "name": "body",
              "value": "={\n  \"model\": \"claude-sonnet-4-6\",\n  \"max_tokens\": 1024,\n  \"system\": \"You are TrueSpend's InfoSec Agent. You assess new suppliers for information security risks and requirements. You evaluate what certifications and controls should be required based on supplier category and data access. Always return structured JSON.\",\n  \"messages\": [{\n    \"role\": \"user\",\n    \"content\": \"Assess this supplier's information security requirements.\\n\\nSUPPLIER:\\nName: {{ $node['Extract Supplier'].json.supplier_name }}\\nCountry: {{ $node['Extract Supplier'].json.country }}\\nCategory: {{ $node['Extract Supplier'].json.category }}\\n\\nBased on the supplier category, assess:\\n1. What InfoSec certifications should be required? (ISO 27001, SOC2, etc.)\\n2. What security controls are minimum requirements?\\n3. What is the risk level for this supplier type?\\n4. Generate Technical and Organisational Measures (TOMs) text for the DPA Annex 2\\n5. What ongoing security monitoring is required?\\n\\nReturn JSON:\\n{\\n  \\\"infosec_score\\\": 0-100,\\n  \\\"risk_level\\\": \\\"low|medium|high|critical\\\",\\n  \\\"iso27001_required\\\": true|false,\\n  \\\"soc2_required\\\": true|false,\\n  \\\"tom_content\\\": \\\"full TOM text for DPA Annex 2\\\",\\n  \\\"findings\\\": [],\\n  \\\"blockers\\\": [],\\n  \\\"recommendations\\\": [],\\n  \\\"passed\\\": true|false\\n}\"\n  }]\n}"
            }
          ]
        }
      },
      "position": [
        960,
        100
      ],
      "options": {
        "timeout": 120000
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "claude_lksg",
      "name": "LkSG & Ethics Agent â€” Supply Chain Compliance",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "bodyParameters": {
          "parameters": [
            {
              "name": "body",
              "value": "={\n  \"model\": \"claude-sonnet-4-6\",\n  \"max_tokens\": 1024,\n  \"system\": \"You are TrueSpend's Supply Chain Compliance Agent. You assess suppliers for compliance with the German Supply Chain Due Diligence Act (Lieferkettensorgfaltspflichtengesetz â€” LkSG), Code of Conduct requirements, sanctions screening, and ethical sourcing standards. Always return structured JSON.\",\n  \"messages\": [{\n    \"role\": \"user\",\n    \"content\": \"Assess this supplier for LkSG, ethics, and supply chain compliance.\\n\\nSUPPLIER:\\nName: {{ $node['Extract Supplier'].json.supplier_name }}\\nCountry: {{ $node['Extract Supplier'].json.country }}\\nCategory: {{ $node['Extract Supplier'].json.category }}\\n\\nAssess:\\n1. LkSG risk level based on country and category (human rights, environmental risks)\\n2. Sanctions screening risk (high-risk countries, restricted entities)\\n3. Code of Conduct requirements\\n4. Modern slavery and forced labour risk\\n5. Environmental compliance requirements\\n\\nReturn JSON:\\n{\\n  \\\"lksg_risk_level\\\": \\\"low|medium|high\\\",\\n  \\\"lksg_compliant\\\": true|false|null,\\n  \\\"sanctions_risk\\\": \\\"low|medium|high\\\",\\n  \\\"coc_required\\\": true|false,\\n  \\\"findings\\\": [],\\n  \\\"blockers\\\": [],\\n  \\\"recommendations\\\": [],\\n  \\\"passed\\\": true|false\\n}\"\n  }]\n}"
            }
          ]
        }
      },
      "position": [
        960,
        300
      ],
      "options": {
        "timeout": 120000
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "parse_lawyer",
