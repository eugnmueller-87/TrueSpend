        },
        "bodyParameters": {
          "parameters": [
            {
              "name": "body",
              "value": "={{ JSON.stringify({ supplier_id: $node['Extract Supplier'].json.supplier_id, check_type: 'lawyer', status: $json.lawyer_passed === 'true' ? 'green' : 'red', score: parseFloat($json.legal_risk_score), passed: $json.lawyer_passed === 'true', findings: JSON.parse($json.lawyer_findings), blockers: JSON.parse($json.lawyer_blockers), docs_required: $json.nda_required === 'true' ? ['nda'] : [] }) }}"
            }
          ]
        }
      },
      "position": [
