{
  "name": "TrueSpend — Board Action (money writes off the browser)",
  "description": "Phase 2: the single server-side entry point for board money/state writes. The SPA POSTs {action, ...ids} here with NO money-capable token; this workflow re-fetches authoritative fields server-side and calls the right SECURITY DEFINER RPC using the server-held PostgREST credential (which carries a privileged app_role). This is what lets the money RPCs go fail-closed without bricking the board. Actions: approve | reject | close | confirm_delivery | match_invoice | create_payment | budget_upsert | user_create | user_set_active | user_set_role.",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "board-action",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook_in",
      "name": "Webhook /board-action",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "board-action"
    },
    {
      "parameters": {
        "jsCode": "// ── Deterministic action gate ──\n// Validate the action against a strict allowlist and normalize the body. The\n// browser supplies only intent + ids; this workflow re-fetches authoritative\n// fields server-side before any money RPC, so a tampered browser payload cannot\n// steer amounts/categories.\nconst body = $json.body || $json;\nconst ACTIONS = new Set([\n  'approve','reject','close','confirm_delivery','match_invoice','create_payment',\n  'budget_upsert','user_create','user_set_active','user_set_role'\n]);\nconst action = String(body.action || '');\nif (!ACTIONS.has(action)) {\n  return [{ json: { __reject: true, status: 400, error: 'unknown action: ' + action } }];\n}\nconst UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nconst need = (v, name) => { if (!v || !UUID.test(String(v))) throw new Error('missing/invalid ' + name); return v; };\ntry {\n  const out = { action, raw: body };\n  if (action === 'approve' || action === 'reject' || action === 'close') {\n    out.ticket_id = need(body.ticket_id, 'ticket_id');\n  } else if (action === 'confirm_delivery') {\n    out.po_id = need(body.po_id, 'po_id'); out.confirmed_by = String(body.confirmed_by || '');\n  } else if (action === 'match_invoice') {\n    out.invoice_id = need(body.invoice_id, 'invoice_id');\n  } else if (action === 'create_payment') {\n    out.invoice_id = need(body.invoice_id, 'invoice_id'); out.due_date = String(body.due_date || '');\n  } else if (action === 'budget_upsert') {\n    out.budget = Number(body.budget); out.id = body.id || null;\n    out.branch_id = body.branch_id || null; out.cost_center_id = body.cost_center_id || null;\n    out.category = body.category || null; out.period = body.period || null;\n  } else if (action === 'user_create') {\n    out.user = { name: body.name, email: body.email, role: body.role, branch_id: body.branch_id, title: body.title, active: true };\n  } else if (action === 'user_set_active') {\n    out.id = need(body.id, 'id'); out.active = !!body.active;\n  } else if (action === 'user_set_role') {\n    out.id = need(body.id, 'id'); out.role = String(body.role || '');\n  }\n  return [{ json: out }];\n} catch (e) {\n  return [{ json: { __reject: true, status: 400, error: e.message } }];\n}"
      },
