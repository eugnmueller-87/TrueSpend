{
  "name": "TrueSpend â€” Intake Receiver",
  "description": "Receives all stakeholder submissions from the intake UI. Agent reasons across all five signals, acts immediately, communicates with supplier directly. Routes to a person only if genuinely unresolvable.",
  "nodes": [
    {
      "id": "webhook_trigger",
      "name": "Intake Form Submitted",
      "type": "n8n-nodes-base.webhook",
      "parameters": {
        "path": "intake",
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "responseData": "allEntries"
      },
      "position": [
        0,
        300
      ]
    },
    {
      "id": "generate_reference",
      "name": "Generate Ticket Reference",
      "type": "n8n-nodes-base.set",
      "parameters": {
        "values": {
          "string": [
            {
              "name": "reference",
              "value": "=TS-{{ new Date().getFullYear() }}-{{ String(Math.floor(Math.random() * 9000) + 1000) }}"
            },
            {
              "name": "received_at",
              "value": "={{ new Date().toISOString() }}"
            }
          ]
        }
      },
      "position": [
        200,
        300
      ]
    },
    {
      "id": "create_ticket",
      "name": "Create Ticket in PostgREST",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "POST",
        "url": "https://postgrest-production-7960.up.railway.app/tickets",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.POSTGREST_JWT }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "bodyParameters": {
          "parameters": [
            {
              "name": "body",
              "value": "={{ JSON.stringify({ reference: $node['Generate Ticket Reference'].json.reference, source: 'intake', status: 'reasoning', title: $node['Intake Form Submitted'].json.body.title, description: $node['Intake Form Submitted'].json.body.description, requested_by: $node['Intake Form Submitted'].json.body.submitted_by, amount: $node['Intake Form Submitted'].json.body.amount, currency: $node['Intake Form Submitted'].json.body.currency || 'EUR', target_close: new Date(Date.now() + 15 * 60 * 1000).toISOString() }) }}"
            }
          ]
        }
      },
      "position": [
        400,
        300
      ],
      "options": {
        "timeout": 30000
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "respond_immediately",
      "name": "Respond to UI â€” Received",
      "type": "n8n-nodes-base.respondToWebhook",
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'received', reference: $node['Generate Ticket Reference'].json.reference, message: 'The agent is reviewing this. You will hear back shortly.' }) }}"
      },
      "position": [
        600,
        150
      ]
    },
    {
      "id": "fetch_supplier",
      "name": "Fetch Supplier Context",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "GET",
        "url": "=https://postgrest-production-7960.up.railway.app/suppliers?name=ilike.*{{ encodeURIComponent($node['Intake Form Submitted'].json.body.supplier_name) }}*",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.POSTGREST_JWT }}"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        }
      },
      "position": [
        600,
        300
      ]
    },
    {
      "id": "fetch_contract",
      "name": "Fetch Contract Context",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "GET",
        "url": "=https://postgrest-production-7960.up.railway.app/contracts?supplier_id=eq.{{ $json[0]?.id }}&branch_id=eq.{{ $node['Intake Form Submitted'].json.body.branch_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.POSTGREST_JWT }}"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        }
      },
      "position": [
        800,
        300
      ]
    },
    {
      "id": "fetch_budget",
      "name": "Fetch Budget Context",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "GET",
        "url": "=https://postgrest-production-7960.up.railway.app/budget_positions?branch_id=eq.{{ $node['Intake Form Submitted'].json.body.branch_id }}&period=eq.{{ new Date().getFullYear() + '-Q' + Math.ceil((new Date().getMonth()+1)/3) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.POSTGREST_JWT }}"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        }
      },
      "position": [
        1000,
        300
      ]
    },
    {
      "id": "fetch_manager",
      "name": "Fetch Responsible Manager",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "GET",
        "url": "=https://postgrest-production-7960.up.railway.app/users?branch_ids=cs.{$node['Intake Form Submitted'].json.body.branch_id}&active=eq.true&role=in.(head_of_procurement,category_manager,ops_manager)&order=spend_authority.desc&limit=1",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.POSTGREST_JWT }}"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        }
      },
      "position": [
        1000,
        450
      ]
    },
    {
      "id": "call_claude_reason",
      "name": "Claude â€” Reason on Intake",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "bodyParameters": {
          "parameters": [
            {
              "name": "body",
              "value": "={\n  \"model\": \"claude-sonnet-4-6\",\n  \"max_tokens\": 2048,\n  \"system\": \"You are TrueSpend, an agentic procurement operating system. You reason across five signals simultaneously â€” contract terms, consumption vs budget, supplier health, request pattern, and policy state â€” and reach a confident disposition on every procurement request. You act immediately when confident. You communicate directly with suppliers. You only route to a human when the situation genuinely requires human judgment. Always return structured JSON.\",\n  \"messages\": [{\n    \"role\": \"user\",\n    \"content\": \"Reason on this intake request and produce a complete disposition including any supplier communication required.\\n\\nREQUEST:\\n{{ JSON.stringify($node['Intake Form Submitted'].json.body) }}\\n\\nSIGNAL 1 â€” CONTRACT CONTEXT:\\n{{ JSON.stringify($node['Fetch Contract Context'].json) }}\\n\\nSIGNAL 2 â€” BUDGET CONTEXT:\\n{{ JSON.stringify($node['Fetch Budget Context'].json) }}\\n\\nSIGNAL 3 â€” SUPPLIER HEALTH:\\n{{ JSON.stringify($node['Fetch Supplier Context'].json) }}\\n\\nSIGNAL 4 â€” REQUEST PATTERN: This is a {{ $node['Intake Form Submitted'].json.body.ticket_type }} request for {{ $node['Intake Form Submitted'].json.body.amount }} {{ $node['Intake Form Submitted'].json.body.currency || 'EUR' }} submitted by {{ $node['Intake Form Submitted'].json.body.submitted_by }}.\\n\\nSIGNAL 5 â€” POLICY: Standard delegated authority applies. Auto-execute up to manager spend authority. One-touch above. Escalate if novel, high-risk, or supplier health is red.\\n\\nReturn JSON:\\n{\\n  disposition: 'auto_execute' | 'one_touch' | 'escalate',\\n  confidence: 0.00-1.00,\\n  reasoning: string,\\n  recommendation: string,\\n  brief: string,\\n  action_taken: string,\\n  supplier_email_subject: string | null,\\n  supplier_email_body: string | null,\\n  requires_order: boolean,\\n  order_details: object | null\\n}\"\n  }]\n}"
            }
          ]
        }
      },
      "position": [
        1200,
        300
      ],
      "options": {
        "timeout": 120000
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "parse_response",
      "name": "Parse Claude Response",
      "type": "n8n-nodes-base.set",
      "parameters": {
        "values": {
          "string": [
            {
              "name": "disposition",
              "value": "={{ JSON.parse($json.content[0].text).disposition }}"
            },
            {
              "name": "confidence",
              "value": "={{ JSON.parse($json.content[0].text).confidence }}"
            },
            {
              "name": "reasoning",
              "value": "={{ JSON.parse($json.content[0].text).reasoning }}"
            },
            {
              "name": "recommendation",
              "value": "={{ JSON.parse($json.content[0].text).recommendation }}"
            },
            {
              "name": "brief",
              "value": "={{ JSON.parse($json.content[0].text).brief }}"
            },
            {
              "name": "action_taken",
              "value": "={{ JSON.parse($json.content[0].text).action_taken }}"
            },
            {
              "name": "supplier_email_subject",
              "value": "={{ JSON.parse($json.content[0].text).supplier_email_subject }}"
            },
            {
              "name": "supplier_email_body",
              "value": "={{ JSON.parse($json.content[0].text).supplier_email_body }}"
            },
            {
              "name": "requires_order",
              "value": "={{ JSON.parse($json.content[0].text).requires_order }}"
            },
            {
              "name": "order_details",
              "value": "={{ JSON.stringify(JSON.parse($json.content[0].text).order_details) }}"
            }
          ]
        }
      },
      "position": [
        1400,
        300
      ]
    },
    {
      "id": "write_decision",
      "name": "Write Decision to PostgREST",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "POST",
        "url": "https://postgrest-production-7960.up.railway.app/decisions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.POSTGREST_JWT }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "bodyParameters": {
          "parameters": [
            {
              "name": "body",
              "value": "={{ JSON.stringify({ ticket_id: $node['Create Ticket in PostgREST'].json[0]?.id || $node['Create Ticket in PostgREST'].json?.id, disposition: $json.disposition, confidence: $json.confidence, reasoning: $json.reasoning, recommendation: $json.recommendation, brief: $json.brief, model_used: 'claude-sonnet-4-6' }) }}"
            }
          ]
        }
      },
      "position": [
        1600,
        300
      ],
      "options": {
        "timeout": 30000
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "write_trace",
      "name": "Write 5 Signal Traces",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "POST",
        "url": "https://postgrest-production-7960.up.railway.app/trace_log",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.POSTGREST_JWT }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "bodyParameters": {
          "parameters": [
            {
              "name": "body",
              "value": "={{ (() => { const did = $node['Write Decision to PostgREST'].json[0]?.id || $node['Write Decision to PostgREST'].json?.id; const parsed = JSON.parse($node['Claude — Reason on Intake'].json.content[0].text); return JSON.stringify([ { decision_id: did, signal: 'contract', value: JSON.stringify($node['Fetch Contract Context'].json), green: !!($node['Fetch Contract Context'].json[0]), notes: 'Signal 1: contract context' }, { decision_id: did, signal: 'budget', value: JSON.stringify($node['Fetch Budget Context'].json), green: !!($node['Fetch Budget Context'].json[0]?.available > 0), notes: 'Signal 2: budget availability' }, { decision_id: did, signal: 'supplier', value: JSON.stringify($node['Fetch Supplier Context'].json), green: ($node['Fetch Supplier Context'].json[0]?.health !== 'red'), notes: 'Signal 3: supplier health' }, { decision_id: did, signal: 'request', value: JSON.stringify({ ticket_type: $node['Intake Form Submitted'].json.body.ticket_type, amount: $node['Intake Form Submitted'].json.body.amount, submitted_by: $node['Intake Form Submitted'].json.body.submitted_by }), green: true, notes: 'Signal 4: request pattern' }, { decision_id: did, signal: 'policy', value: JSON.stringify({ disposition: parsed.disposition, confidence: parsed.confidence }), green: parsed.confidence >= 0.90, notes: 'Signal 5: policy and confidence' } ]); })() }}"
            }
          ]
        }
      },
      "position": [
        1600,
        450
      ],
      "options": {
        "timeout": 30000
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "route_disposition",
      "name": "Route by Disposition",
      "type": "n8n-nodes-base.switch",
      "parameters": {
        "dataType": "string",
        "value1": "={{ $node['Parse Claude Response'].json.disposition }}",
        "rules": {
          "rules": [
            {
              "value2": "auto_execute",
              "outputIndex": 0
            },
            {
              "value2": "one_touch",
              "outputIndex": 1
            },
            {
              "value2": "escalate",
              "outputIndex": 2
            }
          ]
        }
      },
      "position": [
        1800,
        300
      ]
    },
    {
      "id": "send_supplier_email",
      "name": "Send Email to Supplier",
      "type": "n8n-nodes-base.emailSend",
      "parameters": {
        "fromEmail": "procurement@company.com",
        "toEmail": "={{ $node['Fetch Supplier Context'].json[0]?.contact_email }}",
        "subject": "={{ $node['Parse Claude Response'].json.supplier_email_subject }}",
        "text": "={{ $node['Parse Claude Response'].json.supplier_email_body }}"
      },
      "position": [
        2000,
        150
      ]
    },
    {
      "id": "log_supplier_email",
      "name": "Log Email to PostgREST",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "POST",
        "url": "https://postgrest-production-7960.up.railway.app/supplier_emails",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.POSTGREST_JWT }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "bodyParameters": {
          "parameters": [
            {
              "name": "body",
              "value": "={{ JSON.stringify({ supplier_id: $node['Fetch Supplier Context'].json[0]?.id, direction: 'outbound', subject: $node['Parse Claude Response'].json.supplier_email_subject, body_summary: $node['Parse Claude Response'].json.action_taken, received_at: new Date().toISOString() }) }}"
            }
          ]
        }
      },
      "position": [
        2000,
        280
      ],
      "options": {
        "timeout": 30000
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "close_ticket_auto",
      "name": "Close Ticket â€” Auto Executed",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "PATCH",
        "url": "=https://postgrest-production-7960.up.railway.app/tickets?id=eq.{{ $node['Create Ticket in PostgREST'].json[0]?.id || $node['Create Ticket in PostgREST'].json?.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.POSTGREST_JWT }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "bodyParameters": {
          "parameters": [
            {
              "name": "body",
              "value": "={{ JSON.stringify({ status: 'closed', closed_at: new Date().toISOString() }) }}"
            }
          ]
        }
      },
      "position": [
        2000,
        420
      ],
      "options": {
        "timeout": 30000
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "notify_submitter_done",
      "name": "Notify Submitter â€” Done",
      "type": "n8n-nodes-base.emailSend",
      "parameters": {
        "fromEmail": "procurement@company.com",
        "toEmail": "={{ $node['Intake Form Submitted'].json.body.submitted_by_email }}",
        "subject": "=âœ… Done: {{ $node['Intake Form Submitted'].json.body.title }} [{{ $node['Generate Ticket Reference'].json.reference }}]",
        "text": "=Your request has been processed.\n\nReference: {{ $node['Generate Ticket Reference'].json.reference }}\nAction taken: {{ $node['Parse Claude Response'].json.action_taken }}\n\nNo further action needed from you."
      },
      "position": [
        2000,
        560
      ]
    },
    {
      "id": "one_touch_slack",
      "name": "Log One-Touch to Trace",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "POST",
        "url": "https://postgrest-production-7960.up.railway.app/trace_log",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.POSTGREST_JWT }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "bodyParameters": {
          "parameters": [
            {
              "name": "body",
              "value": "={{ JSON.stringify({ signal: 'intake', value: 'one_touch_pending', notes: 'Ticket ' + ($node['Create Ticket in PostgREST'].json[0]?.id || $node['Create Ticket in PostgREST'].json?.id) + ' â€” ' + $node['Intake Form Submitted'].json.body.title + ' awaiting manager approval on Operations Board.' }) }}"
            }
          ]
        }
      },
      "position": [
        2000,
        750
      ],
      "options": {
        "timeout": 30000
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "update_ticket_pending",
      "name": "Update Ticket â€” Pending Confirm",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "PATCH",
        "url": "=https://postgrest-production-7960.up.railway.app/tickets?id=eq.{{ $node['Create Ticket in PostgREST'].json[0]?.id || $node['Create Ticket in PostgREST'].json?.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.POSTGREST_JWT }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "bodyParameters": {
          "parameters": [
            {
              "name": "body",
              "value": "={{ JSON.stringify({ status: 'pending_confirm', owner_id: $node['Fetch Responsible Manager'].json[0]?.id }) }}"
            }
          ]
        }
      },
      "position": [
        2200,
        750
      ],
      "options": {
        "timeout": 30000
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "create_jira_escalation",
      "name": "Create Jira Escalation",
      "type": "n8n-nodes-base.jira",
      "parameters": {
        "operation": "create",
        "project": "KAN",
        "issueType": "Task",
        "priority": "High",
        "summary": "={{ '[ESCALATE] ' + $node['Intake Form Submitted'].json.body.title + ' â€” ' + $node['Generate Ticket Reference'].json.reference }}",
        "description": "=*Submitted by:* {{ $node['Intake Form Submitted'].json.body.submitted_by }}\n*Amount:* {{ $node['Intake Form Submitted'].json.body.amount }} {{ $node['Intake Form Submitted'].json.body.currency }}\n*Supplier:* {{ $node['Intake Form Submitted'].json.body.supplier_name }}\n\n*Agent Brief:*\n{{ $node['Parse Claude Response'].json.brief }}\n\n*Confidence:* {{ $node['Parse Claude Response'].json.confidence }}\n*Reasoning:* {{ $node['Parse Claude Response'].json.reasoning }}",
        "assignee": "={{ $node['Fetch Responsible Manager'].json[0]?.email }}"
      },
      "position": [
        2000,
        950
      ]
    },
    {
      "id": "update_ticket_escalated",
      "name": "Update Ticket â€” Escalated",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "PATCH",
        "url": "=https://postgrest-production-7960.up.railway.app/tickets?id=eq.{{ $node['Create Ticket in PostgREST'].json[0]?.id || $node['Create Ticket in PostgREST'].json?.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.POSTGREST_JWT }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "bodyParameters": {
          "parameters": [
            {
              "name": "body",
              "value": "={{ JSON.stringify({ status: 'escalated', jira_key: $json.key, jira_url: $json.self, owner_id: $node['Fetch Responsible Manager'].json[0]?.id }) }}"
            }
          ]
        }
      },
      "position": [
        2200,
        950
      ],
      "options": {
        "timeout": 30000
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "approve_and_commit",
      "name": "RPC — Approve & Create PO",
      "type": "n8n-nodes-base.httpRequest",
