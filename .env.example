# ============================================================
# TrueSpend — Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# ── Anthropic ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── PostgreSQL (Railway) ──────────────────────────────────────
DATABASE_URL=postgresql://postgres:<REDACTED_ROTATE_ME>@zephyr.proxy.rlwy.net:24934/railway
# Individual vars for Grafana datasource provisioning:
DATABASE_HOST=zephyr.proxy.rlwy.net
DATABASE_PORT=24934
DATABASE_NAME=railway
DATABASE_USER=postgres
DATABASE_PASSWORD=your-railway-db-<REDACTED_ROTATE_ME>

# ── PostgREST (Railway) ───────────────────────────────────────
POSTGREST_URL=https://postgrest-production-7960.up.railway.app
POSTGREST_JWT=eyJ...                     # HS256, role=truespend_app, 10-year expiry

# ── Intake UI (Railway — VITE_ prefix required for Vite build) ─
# These must be set on the Railway intake service.
# VITE_POSTGREST_JWT must use the truespend_app token (NOSUPERUSER login role).
# If this is stale/missing the role switcher shows empty and all RPCs return 401.
VITE_POSTGREST_URL=https://postgrest-production-7960.up.railway.app
VITE_POSTGREST_JWT=eyJ...                # same HS256 token as POSTGREST_JWT above
VITE_N8N_WEBHOOK_URL=https://n8n-n3xl.eugenmueller.tech/webhook/intake
VITE_N8N_WEBHOOK_BASE=https://n8n-n3xl.eugenmueller.tech/webhook

# Phase 2 money-routing seam. When 'true', the SPA routes ALL money/budget/user
# writes through n8n /webhook/board-action (server holds a privileged token)
# instead of calling the RPCs directly with the browser token. Set this to true
# ONLY once board_action.json is live AND the n8n token carries a privileged
# app_role AND step12_money_rpcs_fail_closed.sql is applied — otherwise the board
# bricks (the browser token alone can no longer move money). Default off.
VITE_ROUTE_MONEY_VIA_N8N=false

# ── Jira ─────────────────────────────────────────────────────
# API token: id.atlassian.com → Security → API tokens
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=your-jira-email@company.com
JIRA_API_TOKEN=ATATT...
JIRA_PROJECT_KEY=PROC

# ── Email (IMAP + SMTP) ───────────────────────────────────────
# GMX free account — enable IMAP at gmx.net → Settings → POP3/IMAP
IMAP_HOST=imap.gmx.net
IMAP_PORT=993
IMAP_USER=truespend.ops@gmx.de
IMAP_PASSWORD=your-gmx-<REDACTED_ROTATE_ME>

IMAP_INVOICES_HOST=imap.gmx.net
IMAP_INVOICES_PORT=993
IMAP_INVOICES_USER=truespend.ops@gmx.de
IMAP_INVOICES_FOLDER=INVOICES

SMTP_HOST=mail.gmx.net
SMTP_PORT=587
SMTP_USER=truespend.ops@gmx.de
SMTP_PASSWORD=your-gmx-<REDACTED_ROTATE_ME>

# Sender address for outbound supplier email (fixed-template acks etc.).
# Must be an address that passes SPF/DMARC for the sending domain — NOT a
# placeholder like procurement@company.com. Workflows fail loudly if unset.
PROCUREMENT_FROM_EMAIL=truespend.ops@gmx.de

# ── OpenAI (for llm_consumption workflow) ────────────────────
OPENAI_API_KEY=sk-...

# ── Delivery Confirmation Webhook Auth ───────────────────────
# Basic Auth password for POST /webhook/delivery-confirmation
# Same value goes into the n8n Basic Auth credential (user: truespend)
DELIVERY_WEBHOOK_USER=truespend
DELIVERY_WEBHOOK_SECRET=generate-with-openssl-rand-hex-24

# ── Intake URL (used in DocuSign callback + PO emails) ────────
INTAKE_URL=https://intake-production-84a0.up.railway.app

# ── n8n ──────────────────────────────────────────────────────
# Only needed if self-hosting n8n
N8N_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678         # change to your public URL in production

# ── Grafana ──────────────────────────────────────────────────
# Only needed if self-hosting Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-in-production
GF_SERVER_ROOT_URL=http://localhost:3000

# ── DocuSign (eSignature) ─────────────────────────────────────
# Admin → Apps and Keys → Add App and Integration Key
# Auth method: JWT Grant (server-to-server, no user popup)
#
# Step 1: Admin → Apps and Keys → create app → copy Integration Key
DOCUSIGN_INTEGRATION_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Step 2: same app → Generate RSA Keypair → save private key here (single line, \n escaped)
DOCUSIGN_RSA_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# Step 3: Admin → Apps and Keys → API Account ID (the GUID at the top of the page)
DOCUSIGN_ACCOUNT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Step 4: your DocuSign user ID — Admin → Users → click your name → User ID
DOCUSIGN_USER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Sandbox base URL (use https://www.docusign.net/restapi for production)
DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi
# OAuth token endpoint (demo; production: https://account.docusign.com)
DOCUSIGN_OAUTH_URL=https://account-d.docusign.com
