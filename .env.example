# ============================================================
# TrueSpend — Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# ── Anthropic ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Supabase ─────────────────────────────────────────────────
# Found at: supabase.com → your project → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...           # service_role key (not anon)
SUPABASE_DB_HOST=db.xxxxxxxxxxxx.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-db-password

# ── Slack ────────────────────────────────────────────────────
# Bot token: api.slack.com → your app → OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-...
# Channel IDs (right-click channel → Copy link → last segment)
SLACK_CHANNEL_PROCUREMENT_OPS=#procurement-ops
SLACK_CHANNEL_PROCUREMENT_CLOUD=#procurement-cloud
SLACK_CHANNEL_ALERTS=#procurement-alerts

# ── Jira ─────────────────────────────────────────────────────
# API token: id.atlassian.com → Security → API tokens
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=your-jira-email@company.com
JIRA_API_TOKEN=ATATT...
JIRA_PROJECT_KEY=PROC

# ── Email (IMAP + SMTP for supplier reply handler) ───────────
# Use a dedicated procurement mailbox, not a personal account
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=procurement@yourcompany.com
IMAP_PASSWORD=your-app-password          # Gmail: use App Password, not account password

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=procurement@yourcompany.com
SMTP_PASSWORD=your-app-password

# ── n8n ──────────────────────────────────────────────────────
# Only needed if self-hosting n8n
N8N_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678         # change to your public URL in production

# ── Grafana ──────────────────────────────────────────────────
# Only needed if self-hosting Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-in-production
GF_SERVER_ROOT_URL=http://localhost:3000
